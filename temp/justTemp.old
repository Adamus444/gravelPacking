#include <SPI.h>

// Pin configuration (Arduino Uno/Nano)
// SCK  -> D13 (hardware SPI clock)
// SO   -> D12 (MISO)
// CS   -> D10 (any digital pin works)
const uint8_t PIN_CS = 10;

// MAX6675 supports up to 4.3 MHz SPI, mode 0
SPISettings max6675Settings(4000000, MSBFIRST, SPI_MODE0);

// Returns temperature in °C, or NAN if the thermocouple is disconnected
float readThermocoupleC() {
  uint16_t raw;

  SPI.beginTransaction(max6675Settings);
  digitalWrite(PIN_CS, LOW);
  delayMicroseconds(10);

  raw  = SPI.transfer(0x00) << 8;   // high byte
  raw |= SPI.transfer(0x00);        // low byte

  digitalWrite(PIN_CS, HIGH);
  SPI.endTransaction();

  // Bit 2 (D2) is set when the thermocouple input is open
  if (raw & 0x0004) {
    return NAN;
  }

  // Bits 14..3 hold the 12-bit temperature, 0.25 °C per LSB
  raw >>= 3;
  return raw * 0.25;
}

void setup() {
  Serial.begin(9600);
  pinMode(PIN_CS, OUTPUT);
  digitalWrite(PIN_CS, HIGH);
  SPI.begin();

  delay(500);  // let the MAX6675 stabilize
  Serial.println("MAX6675 thermocouple reader");
}

void loop() {
  float tempC = readThermocoupleC();

  if (isnan(tempC)) {
    Serial.println("Error: thermocouple not connected");
  } else {
    Serial.print("Temperature: ");
    Serial.print(tempC, 2);
    Serial.print(" C  (");
    Serial.print(tempC * 9.0 / 5.0 + 32.0, 2);
    Serial.println(" F)");
  }

  delay(1000);  // MAX6675 needs >= 220 ms between conversions
}